# --- Secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.ruff_cache/
.pytest_cache/
.pyre/
.pytype/
.hypothesis/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Packaging / build output ---
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
pip-wheel-metadata/

# --- Testing / coverage ---
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Logs ---
*.log

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS files ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# --- Claude Code (local settings only) ---
.claude/settings.local.json

